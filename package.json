{
  "name": "@crawlbrulee/sdk",
  "version": "0.10.0",
  "description": "Official TypeScript / JavaScript SDK for crawlbrulee - web-scraping API.",
  "keywords": [
    "crawlbrulee",
    "sdk",
    "scrape",
    "scraping",
    "crawler",
    "web-scraping",
    "screenshot",
    "sitemap"
  ],
  "license": "AGPL-3.0-only",
  "type": "module",
  "packageManager": "pnpm@10.10.0",
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/crawlbrulee/crawlbrulee-js.git"
  },
  "homepage": "https://github.com/crawlbrulee/crawlbrulee-js#readme",
  "bugs": {
    "url": "https://github.com/crawlbrulee/crawlbrulee-js/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "clean": "rm -rf dist coverage .turbo node_modules",
    "verify": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test && pnpm build",
    "prepublishOnly": "pnpm verify"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@types/node": "^22.10.0",
    "@vitest/coverage-v8": "^2.1.0",
    "eslint": "^9.18.0",
    "prettier": "^3.4.0",
    "tsdown": "^0.22.11",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.64.0",
    "vitest": "^2.1.0"
  }
}
